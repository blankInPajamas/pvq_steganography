+  _idx = icwrs(_n,_y);
+  _V   = CELT_PVQ_V(_n,_k);
+  _idx_mod = _idx;
+
+  pvq_log_open();
+  if (g_pvq_log) {
+    fprintf(g_pvq_log, "%llu\t%d\t%d\t%d\t%u\t%u\n",
+            g_pvq_frame, g_pvq_band, _n, _k,
+            (unsigned)_V, (unsigned)_idx);
+  }
+
+  pvq_mod_open();
+
+  /* Track partition index within the current band. Reset on band change. */
+  if (g_pvq_band != g_pvq_band_last_seen) {
+      g_pvq_partition_counter = 0;
+      g_pvq_band_last_seen = g_pvq_band;
+  } else {
+      g_pvq_partition_counter++;
+  }
+
+  if (g_pvq_target_frame >= 0 && g_pvq_target_band >= 0 && g_pvq_delta != 0) {
+    int part_match = (g_pvq_target_partition < 0
+                      || g_pvq_partition_counter == (int)g_pvq_target_partition);
+    if ((long)g_pvq_frame == g_pvq_target_frame
+        && g_pvq_band == g_pvq_target_band
+        && part_match) {
+      long newval = ((long)_idx + g_pvq_delta) % (long)_V;
+      if (newval < 0) newval += (long)_V;
+      _idx_mod = (opus_uint32)newval;
+      if (g_pvq_mod_log) {
+        fprintf(g_pvq_mod_log, "%llu\t%d\t%d\t%d\t%d\t%u\t%u\t%u\t%ld\n",
+                g_pvq_frame, g_pvq_band, g_pvq_partition_counter,
+                _n, _k, (unsigned)_V, (unsigned)_idx, (unsigned)_idx_mod,
+                g_pvq_delta);
+        fflush(g_pvq_mod_log);
+      }
+    }
+  }
+
+  ec_enc_uint(_enc,_idx_mod,_V);
 }
 
