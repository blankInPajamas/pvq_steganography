+static void pvq_mod_open(void) {
+    if (g_pvq_mod_init) return;
+    g_pvq_mod_init = 1;
+    const char *tf = getenv("PVQ_MOD_TARGET_FRAME");
+    const char *tb = getenv("PVQ_MOD_TARGET_BAND");
+    const char *tp = getenv("PVQ_MOD_TARGET_PARTITION");
+    const char *d  = getenv("PVQ_MOD_DELTA");
+    const char *ml = getenv("PVQ_MOD_LOG");
+    if (tf) g_pvq_target_frame     = atol(tf);
+    if (tb) g_pvq_target_band      = atoi(tb);
+    if (tp) g_pvq_target_partition = atol(tp);
+    if (d)  g_pvq_delta            = atol(d);
