# ============================================================
# PVQ Steganography — frozen experiment configuration
# ============================================================
# Committed to git. Every machine that runs `make bootstrap`
# uses these values. Do not change without re-recording the
# reference hashes below.
# ============================================================

# ---- libopus source --------------------------------------------------------

OPUS_REPO=https://gitlab.xiph.org/xiph/opus.git
OPUS_REF=v1.5.2
OPUS_ARITH=--enable-fixed-point

# ---- test clip -------------------------------------------------------------
# Renamed from cv_001.opusraw to cv_001_base.opusraw in the
# portable pipeline, so the baseline artifact name is explicit.

CLIP=cv_001
CLIP_SHA256=dbaf6fbacebfe907ce507d0c8da28815bbacd9c41d38b4d2691a45f91de831bc

# ---- encoder settings for the reference run --------------------------------

BITRATE=64000
FRAME_MS=20
MODE=audio
COMPLEXITY=10

# ---- reference outputs -----------------------------------------------------
# The hash below was recorded from data/bitstreams/encoded/cv_001.opusraw
# on 2026-10-02, using the fixed-point build with the Phase 1 + Phase 2
# instrumentation patches applied.

BASELINE_CONTAINER_SHA256=6726d52412194fee83ddf593f9981499ecd26600a53b385b766a405b468d500a
BASELINE_CONTAINER_BYTES=132365

# ---- Phase 2 reference substitution ----------------------------------------
# Target that fires exactly one substitution (band 14, partition 0,
# frame 7). Container hash is filled in after the first successful
# portable-pipeline run on the reference machine.

PHASE2_FRAME=7
PHASE2_BAND=14
PHASE2_PARTITION=0
PHASE2_DELTA=1
PHASE2_MOD_CONTAINER_SHA256=c52303eee0aaebc87cd9b82593fe065c7b562def17ddd12c72cdc05c31acb6a7
